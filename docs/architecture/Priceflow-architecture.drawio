<mxfile host="app.diagrams.net" modified="2026-09-09T18:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="priceflow-arch-v2" name="Priceflow Architecture"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Priceflow System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1" vertex="1" parent="1"><mxGeometry x="470" y="20" width="850" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Event-Driven Cost Management Platform" style="text;html=1;align=center;verticalAlign=middle;fontSize=16" vertex="1" parent="1"><mxGeometry x="550" y="65" width="700" height="30" as="geometry" /></mxCell><mxCell id="upstreamLayer" value="Upstream Systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16" vertex="1" parent="1"><mxGeometry x="30" y="125" width="170" height="150" as="geometry" /></mxCell><mxCell id="vendorFeed" value="Vendor Feed Service (Simulated Upstream)&amp;#xa;&amp;#xa;• Generate cost update events&amp;#xa;• Simulate external vendor/feed system&amp;#xa;• Publish SUBMITTED events&amp;#xa;&amp;#xa;Port: 8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f7e8;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="230" y="115" width="370" height="170" as="geometry" /></mxCell><mxCell id="manualClient" value="Manual / API Entry&amp;#xa;&amp;#xa;Postman / cURL / Future Web UI&amp;#xa;Vendor / Buyer / Approver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#3c78d8;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="650" y="130" width="510" height="140" as="geometry" /></mxCell><mxCell id="microLayer" value="Core Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16" vertex="1" parent="1"><mxGeometry x="30" y="335" width="170" height="240" as="geometry" /></mxCell><mxCell id="costService" value="Cost Request Service&amp;#xa;&amp;#xa;• Consume upstream submissions&amp;#xa;• REST create/update flow&amp;#xa;• Validation &amp;amp; workflow&amp;#xa;• Approval / rejection&amp;#xa;• Publish approved/rejected events&amp;#xa;&amp;#xa;Port: 8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#3c78d8;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="230" y="325" width="260" height="240" as="geometry" /></mxCell><mxCell id="productService" value="Product Service&amp;#xa;&amp;#xa;• Product catalog&amp;#xa;• Vendor information&amp;#xa;• Search/reference data&amp;#xa;&amp;#xa;Port: 8082" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="530" y="325" width="230" height="240" as="geometry" /></mxCell><mxCell id="pricingService" value="Pricing Service&amp;#xa;&amp;#xa;• Consume APPROVED events&amp;#xa;• Apply product cost&amp;#xa;• Cost history&amp;#xa;• Effective dating&amp;#xa;&amp;#xa;Port: 8083" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="800" y="325" width="230" height="240" as="geometry" /></mxCell><mxCell id="notificationService" value="Notification Service&amp;#xa;&amp;#xa;• Consume business events&amp;#xa;• Thymeleaf HTML email&amp;#xa;• Configurable test recipient&amp;#xa;• Gmail SMTP&amp;#xa;&amp;#xa;Port: 8084" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6ea;strokeColor=#d9534f;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1070" y="325" width="240" height="240" as="geometry" /></mxCell><mxCell id="eventLayer" value="Event Streaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16"