{
  "type": "record",
  "name": "CostRequestApprovedEvent",
  "namespace": "com.priceflow.events.costrequest",
  "fields": [
    {"name":"eventId","type":"string"},
    {"name":"eventType","type":"string"},
    {"name":"eventVersion","type":"int","default":1},
    {"name":"occurredAt","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"requestId","type":"string"},
    {"name":"vendorId","type":"string"},
    {"name":"itemNumber","type":"long"},
    {"name":"approvedCost","type":{"type":"bytes","logicalType":"decimal","precision":12,"scale":2}},
    {"name":"effectiveDate","type":{"type":"int","logicalType":"date"}},
    {"name":"approvedBy","type":"string"},
    {"name":"approvedAt","type":{"type":"long","logicalType":"timestamp-millis"}}
  ]
}